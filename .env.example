# Copilot Studio Direct Line token endpoint (returns { token, conversationId, expires_in }).
# Copy this file to .env and replace the placeholder. Never put a Direct Line secret here.
DIRECT_LINE_TOKEN_ENDPOINT=https://<your-environment>.environment.api.powerplatform.com/powervirtualagents/botsbyschema/<your-agent-schema-name>/directline/token?api-version=2022-03-01-preview
